      "Bash(node etl.js *)",
      "Bash(node ./etl.js *)",
      "PowerShell(node etl.js *)",
      "PowerShell(node ./etl.js *)",
      "PowerShell(node .\\etl.js *)",
      "Read(/todos.md)",
