{
  "name": "ttokttok-pet",
  "version": "0.5.0",
  "description": "A floating desktop pet that shows what your Claude desktop Code sessions and Codex threads are doing.",
  "author": "hyukjunlim",
  "repository": "github:hyukjunlim/ttokttok-pet",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test \"test/**/*.test.js\"",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-shortcut.ps1",
    "sprite:clay": "python tools/make_clay.py",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hyukjunlim.ttokttok-pet",
    "productName": "Ttokttok Pet",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "pets/**/*",
      "claude-mod/**/*",
      "!claude-mod/**/*.test.ts",
      "etl-workspace/**/*",
      "browser-extension/**/*",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Ttokttok-Pet-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ttokttok-Pet-Setup-${version}.${ext}"
    }
  }
}
