{
  "manifest_version": 3,
  "name": "Ttokttok Pet: web chats",
  "version": "1.0.6",
  "description": "Tells Ttokttok Pet when a claude.ai, ChatGPT or Gemini reply is being written and when it's done. Sends only each chat's title, address and state, never its messages.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
